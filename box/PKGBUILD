
pkgname='linglong-box'
_pkgver=1.8.2-1.20250415
pkgver=1.8.2
pkgrel=1
pkgdesc="linglong-box"
arch=('x86_64')
url="http://www.deepin.org"
license=('Proprietary')
makedepends=('tar')
source=(
	"linglong-box_amd64.deb::https://ci.deepin.com/repo/obs/linglong:/CI:/release/Deepin_25/amd64/linglong-box_${_pkgver}_amd64.deb"
)
noextract=(
    "linglong-box_amd64.deb"
)
sha256sums=('6d45c282831fbb44d0967eff0d43d888b9a25e1eb87ad8626b2a8f1d62f6f9cd')

options=('!strip' '!debug')  # 关键修复：禁用自动修改

package() {

    mkdir -p "data-unpack"
    ar -x "linglong-box_amd64.deb" data.tar.xz --output "data-unpack"
    tar -xf "data-unpack/data.tar.xz" --directory="${pkgdir}"
}
