
pkgname='linglong-bin'
_pkgver=1.8.2-1.20250515
pkgver=1.8.2
pkgrel=1
pkgdesc="linglong-bin"
arch=('x86_64')
url="http://www.deepin.org"
license=('Proprietary')
makedepends=('tar')
source=(
  "linglong-bin.deb::https://ci.deepin.com/repo/obs/linglong:/CI:/release/Deepin_25/amd64/linglong-bin_1.8.2-1.20250515_amd64.deb"
)
noextract=(
    "linglong-bin.deb"
)
sha256sums=('0b48c9c1a391c59f169aaea8a0f4c04da9f9dfe2c651ca07cda43be538acc411')

options=('!strip' '!debug')  # 关键修复：禁用自动修改

depends=(
desktop-file-utils		#desktop-file-utils,
erofsfuse			#erofsfuse,
glib2				#libglib2.0-bin,libglib2.0-0 (>= 2.40.0),
linglong-box			#linglong-box | crun,
shared-mime-info		#shared-mime-info,
				#init-system-helpers (>= 1.52),
systemd				#systemd | systemd-standalone-sysusers | systemd-sysusers,
glibc				#libc6 (>= 2.38),
curl				#libcurl4 (>= 7.56.1), 
elfutils			#libelf1 (>= 0.142), 
gcc-libs			#libgcc-s1 (>= 3.0),libstdc++6 (>= 11),
ostree				#libostree-1-1 (>= 2017.6),
qt6-base			#libqt6core6 (>= 6.8.0),libqt6dbus6 (>= 6.8.0),libqt6gui6 (>= 6.1.2),libqt6widgets6 (>= 6.1.2),
systemd-libs			#libsystemd0,
'yaml-cpp>=0.7.0'			#libyaml-cpp0.7 (>= 0.7.0)
)

package() {

    mkdir -p "unpack-data"
    ar -x "linglong-bin.deb" data.tar.xz --output "unpack-data"
    tar -xf "unpack-data/data.tar.xz" --directory="${pkgdir}"
    mkdir -p "${pkgdir}/usr"
    cp -av "${pkgdir}/lib" "${pkgdir}/usr/"
    rm -rf "${pkgdir}/lib"
    ln -s libyaml-cpp.so ${pkgdir}/usr/lib/libyaml-cpp.so.0.7
}
