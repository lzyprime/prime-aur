gcc-libs                # libgcc1 (>= 1:3.0)
glib2                   # libglib2.0-0 (>= 2.37.3)
libgphoto2              # libgphoto2-6 (>= 2.5.10), libgphoto2-port12 (>= 2.5.10)
gst-plugins-base        # libgstreamer-plugins-base1.0-0 (>= 1.8.0)
gstreamer               # libgstreamer1.0-0 (>= 1.4.0)
pcsclite                # libpcsclite1 (>= 1.3.3)
libpng                  # libpng16-16 (>= 1.6.2-1)
libpulse                # libpulse0 (>= 0.99.1)
sane                    # libsane (>= 1.0.24)
systemd-libs            # libudev1 (>= 183)
libusb                  # libusb-1.0-0 (>= 2:1.0.21)
libx11                  # libx11-6
libxext                 # libxext6
ocl-icd                 # ocl-icd-libopencl1 | libopencl1, ocl-icd-libopencl1 (>= 1.0) | libopencl-1.2-1
alsa-plugins            # libasound2-plugins
ncurses                 # libncurses6 | libncurses5 | 
glibc                   # libc6 (>= 2.14)
dtkcore                 # libdtkcore5 (>= 5.5)
dtkgui                  # libdtkgui5 (>= 5.5)
dtkwidget               # libdtkwidget5 (>= 5.5)
gcc-libs                # libgcc1 (>= 1:3.0), libstdc++6 (>= 5.2)
qt5-base                # libqt5concurrent5 (>= 5.6.0~rc), libqt5core5a (>= 5.11.0~rc1), libqt5gui5 (>= 5.11.0~rc1), libqt5widgets5 (>= 5.11.0~rc1), libqt5network5 (>= 5.8.0), libqt5sql5 (>= 5.0.2), libqt5dbus5 (>= 5.0.2), libqt5xml5 (>= 5.0.2)
qt5-script	            # libqt5script5 (>= 5.6.0~beta)
vulkan-icd-loader	    # libvulkan1
libx11                  # libx11-6
python-yaml             # python3-yaml
                        # python3-pycurl
python-chardet          # python3-chardet
python-requests         # python3-requests
                        # patool
python-urllib3          # python3-urllib3
                        # python3-certifi
                        # python3-pefile
                        # python3-xdg
                        # python3-dbus
                        # python3-watchdog
                        # python3-markdown
                        # python3-gi
                        # gir1.2-glib-2.0
fakeroot                # fakeroot
                        # debhelper
                        # python3-typing-extensions
