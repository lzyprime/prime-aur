wqy-microhei            # fonts-wqy-microhei
deepin-wine10-stable    # deepin-wine10-stable (>= 10.7deepin9)

)
install=deb.install
package() {

    mkdir -p "unpack"
    ar -x "${pkgname}_${_pkgver}_amd64.deb" data.tar.xz --output unpack
    ar -x "${pkgname}_${_pkgver}_amd64.deb" control.tar.xz --output unpack
    tar -xf "unpack/data.tar.xz" --directory="${pkgdir}"
    sed -i '245c    subprocess.run(["bsdtar", "-xf", get_base_bottle_path(), f"-C {wineprefix}"], check=True)' "${pkgdir}/opt/apps/deepin-wine-builder/files/share/deepin-wine-builder/package-scripts/init-bottle.py"
    mkdir -p "${pkgdir}/var/lib/dpkg/info/$pkgname"
    tar -xf "unpack/control.tar.xz" --directory="${pkgdir}/var/lib/dpkg/info/$pkgname"
}
