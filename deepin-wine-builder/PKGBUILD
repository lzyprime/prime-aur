
pkgname='deepin-wine-builder'
_pkgver=3.3.2.005-1
pkgver=${_pkgver/-/.}
pkgrel="1"
pkgdesc="$pkgname"
arch=('x86_64')
url="http://www.deepin.org"
license=('Proprietary')
makedepends=('tar')
source=(
    "https://com-store-packages.uniontech.com/appstorev23/pool/appstore/d/deepin-wine8-stable/${pkgname}_${_pkgver}_amd64.deb"
)
noextract=(
    "${pkgname}_${_pkgver}_amd64.deb"
)
sha256sums=('71faf4c5952fa9b023292799397e5effe1da367f1fe29306feb188b30a8805c1')
options=('!strip' '!debug')  # 关键修复：禁用自动修改

depends=(
alsa-plugins            # libasound2 (>= 1.0.16)
glibc                   # libc6 (>= 2.26)
#libcapi                # libcapi20-3
